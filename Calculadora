df = pd.DataFrame(dados)

# Cálculos auxiliares (valores em estoque)
df["Valor_Estoque_Custo"] = (df["Preco_Custo"] * df["Estoque"]).round(2)
df["Valor_Estoque_Venda"] = (df["Preco_Venda"] * df["Estoque"]).round(2)

# Resumos por categoria
resumo_categoria = df.groupby("Categoria", as_index=False).agg(
    Itens=("Produto", "count"),
    Estoque_Total=("Estoque", "sum"),
    Valor_Estoque_Custo=("Valor_Estoque_Custo", "sum"),
    Valor_Estoque_Venda=("Valor_Estoque_Venda", "sum")
)

# Totais gerais
totais = pd.DataFrame({
    "Métrica": ["Itens", "Estoque_Total", "Valor_Estoque_Custo", "Valor_Estoque_Venda"],
    "Total": [
        len(df),
        int(df["Estoque"].sum()),
        float(df["Valor_Estoque_Custo"].sum()),
        float(df["Valor_Estoque_Venda"].sum())
    ]
})

# Salvar em Excel com múltiplas abas
caminho_excel = "/mnt/data/planilha_tabacaria.xlsx"
with pd.ExcelWriter(caminho_excel, engine="xlsxwriter") as writer:
    df.to_excel(writer, index=False, sheet_name="Catalogo")
    resumo_categoria.to_excel(writer, index=False, sheet_name="Resumo_por_Categoria")
    totais.to_excel(writer, index=False, sheet_name="Totais_Gerais")
    
    # Melhorias de formatação básicas
    workbook  = writer.book
    fmt_moeda = workbook.add_format({"num_format": "R$ #,##0.00"})
    fmt_int = workbook.add_format({"num_format": "0"})
    # Formatar colunas na aba Catalogo
    ws = writer.sheets["Catalogo"]
    colunas_moeda = ["D","E","L","M"]  # Preco_Custo, Preco_Venda, Valor_Estoque_Custo, Valor_Estoque_Venda
    for col in colunas_moeda:
        ws.set_column(f"{col}:{col}", 16, fmt_moeda)
    ws.set_column("F:F", 10, fmt_int)  # Estoque
    ws.set_column("A:A", 14)
    ws.set_column("B:B", 36)
    ws.set_column("C:C", 18)
    ws.set_column("G:I", 18)
    ws.set_column("J:J", 20)
    ws.set_column("K:K", 20)

    # Resumo_por_Categoria formatação
    ws2 = writer.sheets["Resumo_por_Categoria"]
    ws2.set_column("A:A", 14)
    ws2.set_column("B:B", 10, fmt_int)
    ws2.set_column("C:C", 14, fmt_int)
    ws2.set_column("D:E", 20, fmt_moeda)

    # Totais_Gerais formatação
    ws3 = writer.sheets["Totais_Gerais"]
    ws3.set_column("A:A", 24)
    ws3.set_column("B:B", 20)

# Também salvar CSV (catálogo)
caminho_csv = "/mnt/data/planilha_tabacaria_catalogo.csv"
df.to_csv(caminho_csv, index=False, encoding="utf-8")

# Mostrar a tabela principal para edição rápida no UI
